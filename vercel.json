{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git cat-file -e ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}^{commit} 2>/dev/null || exit 1; git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- ':(top)' ':(top,exclude).github/' ':(top,exclude)tasks/' ':(top,exclude,glob)**/*.md'",
  "functions": {
    "server.py": {
      "excludeFiles": "{tests/**,utils/tests.py,.venv/**,.venv-312/**,alembic/**,sample_data/**,**/*.md}"
    }
  },
  "git": {
    "deploymentEnabled": {
      "flare/*": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}
